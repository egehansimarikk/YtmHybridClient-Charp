<Window x:Class="YtmHybridClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YTM Lossless Hybrid Client" Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        Icon="Gemini_Generated_Image_asxgj7asxgj7asxg.ico"
        Background="#0F0F0F">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Kontrol Çubuğu -->
        <Grid Grid.Row="0" Background="#181818" Height="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <!-- Sol Üst Logo -->
                <Image Source="Gemini_Generated_Image_asxgj7asxgj7asxg.ico" Width="26" Height="26" Margin="0,0,10,0"/>
                <TextBlock Text="YTM Lossless Client" Foreground="#CCCCCC" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Ayarlar Butonu -->
            <Button Content="⚙ Ayarlar" HorizontalAlignment="Right" Margin="0,0,10,0" Padding="12,5" 
                    Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSettings_Click"/>
        </Grid>

        <!-- WebBrowser -->
        <wv2:WebView2 x:Name="YtmWebView" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>
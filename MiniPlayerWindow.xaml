<Window x:Class="YtmHybridClient.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTM Mini Player" Width="260" Height="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ProgressSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="#FF0055" />
            <Setter Property="Background" Value="#444444" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Background="#1E1E1E" BorderBrush="#303030" BorderThickness="1" CornerRadius="12"
            PreviewMouseLeftButtonDown="MiniPlayer_PreviewMouseLeftButtonDown">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Width="64" Height="64" CornerRadius="12"
                    Background="#242424" ClipToBounds="True" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="♪" Foreground="#FF0055" FontSize="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="AlbumArt" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="Şu anda çalmıyor" Foreground="White"
                           FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock x:Name="TxtArtist" Text="" Foreground="#AAAAAA" FontSize="11"
                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>

            <Button Grid.Row="0" Grid.Column="2" Content="↗" Width="24" Height="24"
                    VerticalAlignment="Top" Background="#282828" Foreground="White"
                    BorderThickness="0" ToolTip="Ana pencereye dön" Click="ReturnToMain_Click" />

            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtCurrentTime" Grid.Column="0" Text="00:00" Foreground="#BBBBBB"
                           FontSize="10" VerticalAlignment="Center" />
                <Slider x:Name="SldProgress" Grid.Column="1" Minimum="0" Maximum="0" Value="0"
                        IsMoveToPointEnabled="True" Style="{StaticResource ProgressSlider}"
                        ValueChanged="SldProgress_ValueChanged"
                        PreviewMouseLeftButtonDown="SldProgress_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="SldProgress_PreviewMouseLeftButtonUp" />
                <TextBlock x:Name="TxtTotalTime" Grid.Column="2" Text="00:00" Foreground="#BBBBBB"
                           FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,2,0,0">
                <Button Content="◁|" Width="38" Height="26" Margin="4,0" Background="#282828"
                        Foreground="White" BorderThickness="0" ToolTip="Önceki parça" Click="BtnPrev_Click" />
                <Button x:Name="BtnPlayPause" Content="▶" Width="46" Height="26" Margin="4,0"
                        Background="#FF0055" Foreground="White" BorderThickness="0"
                        ToolTip="Çal / Duraklat" Click="TogglePlayback_Click" />
                <Button Content="|▷" Width="38" Height="26" Margin="4,0" Background="#282828"
                        Foreground="White" BorderThickness="0" ToolTip="Sonraki parça" Click="BtnNext_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

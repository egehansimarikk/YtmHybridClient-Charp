<Window x:Class="YtmHybridClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uygulama Ayarları" Height="420" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#181818" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <TextBlock Grid.Row="0" Text="YTM Lossless Hybrid Client - Ayarlar" FontSize="18" FontWeight="Bold" Foreground="#FF0055" Margin="0,0,0,20"/>

        <!-- Form Alanları -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">

            <!-- Yerel FLAC Klasörü -->
            <TextBlock Text="Yerel FLAC Müzik Klasörü:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFlacFolder" Grid.Column="0" Background="#282828" Foreground="White" BorderThickness="1" BorderBrush="#404040" Padding="8" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Gözat..." Margin="10,0,0,0" Padding="15,8" Background="#383838" Foreground="White" BorderThickness="0" Click="BtnBrowse_Click"/>
            </Grid>

            <!-- Jamendo Client ID -->
            <TextBlock Text="Jamendo API Client ID:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtJamendoClientId" Background="#282828" Foreground="White" BorderThickness="1" BorderBrush="#404040" Padding="8" Margin="0,0,0,15"/>

            <!-- Seçenekler -->
            <CheckBox x:Name="ChkWasapiExclusive" Content="WASAPI Exclusive Modu (Bit-Perfect Ses Kartı Kilidi)" Foreground="White" Margin="0,5,0,10" IsChecked="True"/>
            <CheckBox x:Name="ChkSmartFallback" Content="Akıllı Yedekleme (Lossless bulunamazsa YTM sesini aç)" Foreground="White" Margin="0,0,0,15" IsChecked="True"/>

        </StackPanel>

        <!-- Alt Butonlar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="İptal" Padding="20,8" Margin="0,0,10,0" Background="#383838" Foreground="White" BorderThickness="0" Click="BtnCancel_Click"/>
            <Button Content="Kaydet" Padding="20,8" Background="#FF0055" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
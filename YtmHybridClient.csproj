<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>ytmhybridlogo.ico</ApplicationIcon>
		<PlatformTarget>x64</PlatformTarget>
		<Version>1.6.0</Version>
		<AssemblyVersion>1.6.0.0</AssemblyVersion>
		<FileVersion>1.6.0.0</FileVersion>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="ytmhybridlogo.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="ytmhybridlogo.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DiscordRichPresence" Version="1.3.0.28" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
		<PackageReference Include="NAudio" Version="3.2.0" />
	</ItemGroup>

</Project>